generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum AppearanceTheme {
  BLACK
  DARK
  LIGHT
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_PAYMENT_CONFIRMATION
  PAID
  PAYMENT_FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  PAYMENT_DISPUTED
}

enum PaymentStatus {
  PENDING
  AWAITING_PAYMENT_CONFIRMATION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  MANUAL_PENDING
  MANUAL_COMPLETED
  FAILED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  WON
  LOST
}

enum StripeConnectStatus {
  ONBOARDING
  READY
  RESTRICTED
  DISABLED
}

enum PhotoStatus {
  DRAFT
  PUBLISHED
}

enum QRLinkStatus {
  ACTIVE
  DISABLED
}

enum DownloadGrantStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum FaceIndexJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ManualPaymentAction {
  CONFIRMED
  REJECTED
}

enum ZelleFeeSettlementStatus {
  OPEN
  ROLLED_FORWARD
  INVOICED
  PAID
  VOID
}

model Photographer {
  id                   String                       @id @default(cuid())
  email                String                       @unique
  name                 String
  passwordHash         String
  publicSlug           String?                      @unique
  publicProfileEnabled Boolean                      @default(false)
  appearanceTheme     AppearanceTheme               @default(BLACK)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  events               Event[]
  albums               Album[]
  qrLinks              QRLink[]
  orders               Order[]
  stripeConnectAccount StripeConnectAccount?
  paymentSettings      PhotographerPaymentSettings?
  manualPaymentAudits  ManualPaymentAudit[]
  zelleFeeObligations  ZelleFeeObligation[]

  @@index([createdAt])
}

model PhotographerPaymentSettings {
  id                     String       @id @default(cuid())
  photographerId         String       @unique
  photographer           Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  stripeEnabled          Boolean      @default(true)
  zelleEnabled           Boolean      @default(false)
  zelleDisplayName       String?
  zellePaymentIdentifier String?
  zelleInstructions      String?
  zelleQrKey             String?      @unique
  zelleQrContentType     String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model StripeConnectAccount {
  id               String              @id @default(cuid())
  photographerId   String              @unique
  photographer     Photographer        @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  stripeAccountId  String              @unique
  status           StripeConnectStatus @default(ONBOARDING)
  detailsSubmitted Boolean             @default(false)
  chargesEnabled   Boolean             @default(false)
  payoutsEnabled   Boolean             @default(false)
  currentlyDue     Json?
  disabledReason   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Event {
  id             String        @id @default(cuid())
  photographerId String
  photographer   Photographer  @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  title          String
  slug           String        @unique
  accessCode     String        @unique
  description    String?
  status         PublishStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  albums         Album[]
  orders         Order[]
  qrLinks        QRLink[]

  @@index([photographerId, status])
}

model Album {
  id             String        @id @default(cuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photographerId String
  photographer   Photographer  @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  description    String?
  priceCents     Int           @default(1500)
  status         PublishStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  photos         Photo[]
  qrLinks        QRLink[]

  @@unique([eventId, slug])
  @@index([eventId, status])
  @@index([photographerId, status])
}

model QRLink {
  id             String       @id @default(cuid())
  code           String       @unique
  photographerId String
  photographer   Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  albumId        String?
  album          Album?       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  status         QRLinkStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([photographerId, status])
  @@index([eventId, status])
  @@index([albumId, status])
}

model Photo {
  id               String         @id @default(cuid())
  albumId          String
  album            Album          @relation(fields: [albumId], references: [id], onDelete: Cascade)
  title            String?
  originalKey      String
  previewKey       String
  originalFilename String
  mimeType         String
  fileSize         Int
  width            Int?
  height           Int?
  priceOverrideCents Int?
  currency         String         @default("USD")
  status           PhotoStatus    @default(PUBLISHED)
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  orderItems       OrderItem[]
  faceRecords      PhotoFace[]
  faceIndexJobs    FaceIndexJob[]
}

model PhotoFace {
  id                    String                     @id @default(cuid())
  photoId               String
  photo                 Photo                      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  eventId               String
  albumId               String
  embedding             Unsupported("vector(512)")
  detectionConfidence   Float
  boundingBox           Json
  faceIndex             Int
  providerId            String
  modelId               String
  modelVersion          String
  embeddingFormatVersion String
  embeddingDimension    Int
  similarityMetric      String
  compatibilityKey      String
  createdAt             DateTime                   @default(now())

  @@unique([photoId, compatibilityKey, faceIndex])
  @@index([eventId, compatibilityKey])
  @@index([photoId, compatibilityKey])
}

model FaceIndexJob {
  id          String             @id @default(cuid())
  photoId     String
  photo       Photo              @relation(fields: [photoId], references: [id], onDelete: Cascade)
  status      FaceIndexJobStatus @default(PENDING)
  attempts    Int                @default(0)
  lastError   String?
  createdAt   DateTime           @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime           @updatedAt

  @@unique([photoId])
  @@index([status, createdAt])
}

model Order {
  id                  String               @id @default(cuid())
  publicOrderCode     String               @unique
  eventId             String
  event               Event                @relation(fields: [eventId], references: [id])
  photographerId      String
  photographer        Photographer         @relation(fields: [photographerId], references: [id])
  customerEmail       String
  customerFirstName   String?
  customerLastName    String?
  currency            String               @default("USD")
  subtotalCents       Int
  totalCents          Int
  status              OrderStatus          @default(PENDING_PAYMENT)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  items               OrderItem[]
  payment             Payment?
  grants              DownloadGrant[]
  manualPaymentAudits ManualPaymentAudit[]
  zelleFeeObligation  ZelleFeeObligation?
  refunds             Refund[]
  disputes            PaymentDispute[]

  @@index([photographerId, status])
  @@index([customerEmail])
}

model OrderItem {
  id               String      @id @default(cuid())
  orderId          String
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photoId          String
  photo            Photo       @relation(fields: [photoId], references: [id])
  unitPriceCents   Int
  currency         String      @default("USD")
  originalFilename String?
  refundedAt       DateTime?
  createdAt        DateTime    @default(now())
  refundItem       RefundItem?

  @@unique([orderId, photoId])
}

model Payment {
  id                        String               @id @default(cuid())
  orderId                   String               @unique
  order                     Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider                  String
  providerPaymentId         String?
  providerCheckoutId        String?
  amount                    Int
  currency                  String               @default("USD")
  platformFeeCents          Int                  @default(0)
  photographerProceedsCents Int                  @default(0)
  billablePhotoCount        Int                  @default(0)
  platformFeePerPhotoCents  Int                  @default(25)
  connectedAccountId        String?
  providerChargeId          String?
  providerApplicationFeeId  String?
  status                    PaymentStatus        @default(PENDING)
  idempotencyKey            String               @unique
  rawResponse               Json?
  manualAudits              ManualPaymentAudit[]
  zelleFeeObligation        ZelleFeeObligation?
  refunds                   Refund[]
  disputes                  PaymentDispute[]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  paidAt                    DateTime?
}

model ManualPaymentAudit {
  id                     String              @id @default(cuid())
  orderId                String
  order                  Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId              String
  payment                Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  photographerId         String
  photographer           Photographer        @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  provider               String
  action                 ManualPaymentAction
  previousOrderStatus    OrderStatus
  resultingOrderStatus   OrderStatus
  previousPaymentStatus  PaymentStatus
  resultingPaymentStatus PaymentStatus
  note                   String?
  createdAt              DateTime            @default(now())

  @@unique([paymentId, action])
  @@index([photographerId, action, createdAt])
  @@index([orderId, createdAt])
}

model ZelleFeeObligation {
  id                 String                       @id @default(cuid())
  photographerId     String
  photographer       Photographer                 @relation(fields: [photographerId], references: [id], onDelete: Restrict)
  orderId            String                       @unique
  order              Order                        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId          String                       @unique
  payment            Payment                      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  billablePhotoCount Int
  feePerPhotoCents   Int
  amountCents        Int
  currency           String                       @default("USD")
  status             ZelleFeeSettlementStatus     @default(OPEN)
  earnedAt           DateTime                     @default(now())
  settledAt          DateTime?
  voidedAt           DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  reversals          ZelleFeeObligationReversal[]

  @@index([photographerId, status, earnedAt])
  @@index([status, earnedAt])
}

model Refund {
  id                       String                      @id @default(cuid())
  orderId                  String
  order                    Order                       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId                String
  payment                  Payment                     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  provider                 String
  amountCents              Int
  platformFeeReversalCents Int
  currency                 String                      @default("USD")
  status                   RefundStatus                @default(PENDING)
  reason                   String?
  providerRefundId         String?                     @unique
  idempotencyKey           String                      @unique
  source                   String
  actorId                  String?
  createdAt                DateTime                    @default(now())
  completedAt              DateTime?
  items                    RefundItem[]
  zelleFeeReversal         ZelleFeeObligationReversal?

  @@index([orderId, status, createdAt])
  @@index([paymentId, status, createdAt])
}

model RefundItem {
  id                       String    @id @default(cuid())
  refundId                 String
  refund                   Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItemId              String    @unique
  orderItem                OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  amountCents              Int
  platformFeeReversalCents Int
  createdAt                DateTime  @default(now())

  @@index([refundId])
}

model ZelleFeeObligationReversal {
  id                 String             @id @default(cuid())
  obligationId       String
  obligation         ZelleFeeObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  refundId           String             @unique
  refund             Refund             @relation(fields: [refundId], references: [id], onDelete: Restrict)
  billablePhotoCount Int
  amountCents        Int
  currency           String             @default("USD")
  createdAt          DateTime           @default(now())

  @@index([obligationId, createdAt])
}

model PaymentDispute {
  id                String                @id @default(cuid())
  paymentId         String
  payment           Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  orderId           String
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  providerDisputeId String                @unique
  amountCents       Int
  currency          String                @default("USD")
  status            DisputeStatus
  reason            String?
  openedAt          DateTime              @default(now())
  resolvedAt        DateTime?
  events            PaymentDisputeEvent[]

  @@index([paymentId, status, openedAt])
  @@index([orderId, status, openedAt])
}

model PaymentDisputeEvent {
  id              String         @id @default(cuid())
  disputeId       String
  dispute         PaymentDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  providerEventId String         @unique
  status          DisputeStatus
  createdAt       DateTime       @default(now())

  @@index([disputeId, createdAt])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String    @unique
  attempts        Int       @default(0)
  processedAt     DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DownloadGrant {
  id         String              @id @default(cuid())
  orderId    String
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tokenHash  String              @unique
  status     DownloadGrantStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  revokedAt  DateTime?
  lastUsedAt DateTime?
  usageCount Int                 @default(0)

  @@unique([orderId])
  @@index([orderId, status])
  @@index([expiresAt])
}
